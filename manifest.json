{
  "manifest_version": "0.3",
  "name": "fv-backlog-mcp-server",
  "display_name": "FV Backlog MCP Server (project-scoped)",
  "version": "0.1.0",
  "description": "MCP server for Nulab Backlog, confined to an explicit allow-list of projects",
  "author": {
    "name": "fyosimi",
    "url": "https://github.com/fv-forgevision"
  },
  "server": {
    "type": "node",
    "entry_point": "build/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/build/index.js"
      ],
      "env": {
        "BACKLOG_API_KEY": "${user_config.backlog_api_key}",
        "BACKLOG_DOMAIN": "${user_config.backlog_domain}",
        "BACKLOG_ALLOWED_PROJECTS": "${user_config.backlog_allowed_projects}"
      }
    }
  },
  "tools_generated": true,
  "user_config": {
    "backlog_api_key": {
      "type": "string",
      "title": "Backlog API Key",
      "description": "API key for authenticating with Backlog",
      "required": true,
      "sensitive": true
    },
    "backlog_domain": {
      "type": "string",
      "title": "Backlog Domain",
      "description": "Your Backlog domain (e.g. your-space.backlog.com)",
      "required": true,
      "sensitive": false
    },
    "backlog_allowed_projects": {
      "type": "string",
      "title": "Allowed Projects",
      "description": "Comma-separated project keys this server may touch (e.g. PBL,INFRA). Leave empty to allow the whole space.",
      "required": false,
      "sensitive": false
    }
  },
  "keywords": [
    "backlog",
    "project-management",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fv-forgevision/fv-backlog-mcp-server.git"
  },
  "icon": "icon.png",
  "homepage": "https://github.com/fv-forgevision/fv-backlog-mcp-server",
  "support": "https://github.com/fv-forgevision/fv-backlog-mcp-server/issues"
}
